# Copy to .env on the server and fill in. Never commit .env.
APP_NAME="Dr. Ayman El Sudany"
APP_ENV=production
# Left empty, /setup writes one. Or run: php artisan key:generate
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Bluehost: cPanel > MySQL Databases (database and user names start with the cPanel username).
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_drayman
DB_USERNAME=cpaneluser_drayman
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_COOKIE=aes_admin
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict
SESSION_HTTP_ONLY=true

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Long random string (20+ characters) for the one-time /setup?token=... page. Empty it after setup.
CLINIC_SETUP_TOKEN=

# Optional: email told about each new booking or referral. Bluehost: use an email account from cPanel.
CLINIC_NOTIFY_EMAIL=
MAIL_MAILER=smtp
MAIL_HOST=mail.example.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Optional: Google Places API (New) key, restricted to the server IP. Put the Place ID in Dashboard > Settings.
GOOGLE_PLACES_KEY=

# Optional: send each booking/referral to the clinic WhatsApp (WhatsApp Business Cloud API, approved template with 5 variables).
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_TO=
WHATSAPP_CLOUD_TEMPLATE=
WHATSAPP_CLOUD_LANGUAGE=ar
